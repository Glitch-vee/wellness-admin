# Admin app (alvee-admin) — server-side full CMS access
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose client-side

# Login
ADMIN_PASSWORD=pick-a-strong-password
SESSION_SECRET=long-random-string

# Publishing to the live site
MAIN_SITE_URL=https://alvee-wellness.vercel.app
NEXT_PUBLIC_MAIN_SITE_URL=https://alvee-wellness.vercel.app
REVALIDATE_SECRET=same-value-as-main-site
